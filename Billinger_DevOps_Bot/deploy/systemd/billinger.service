[Unit]
Description=Billinger DevOps Bot Production Platform
Documentation=https://github.com/your-repo/billinger
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/billinger/Billinger_DevOps_Bot
Environment=BILLINGER_HOST=0.0.0.0
Environment=BILLINGER_PORT=8080
Environment=BILLINGER_NO_BROWSER=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
